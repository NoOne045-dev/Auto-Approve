# ─── Telegram Bot Credentials ───────────────────────────────────────────────
# Obtain BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Obtain API_ID and API_HASH from https://my.telegram.org/apps
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ─── Bot Owners & Admins ─────────────────────────────────────────────────────
# Master Bot Owner Telegram User ID (numeric)
OWNER_ID=123456789

# Optional extra Super Admin IDs (space or comma separated)
ADMINS=987654321

# ─── Database Configuration ──────────────────────────────────────────────────
# MongoDB Connection URI (e.g. MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=AutoApproveBot

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Max join request approvals per second (Telegram safe: 20-30)
MAX_APPROVALS_PER_SECOND=25

# ─── Anti-Spam & Security ────────────────────────────────────────────────────
# Enable Combot Anti-Spam (CAS) global ban list check (https://cas.chat)
ENABLE_CAS_CHECK=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
